{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://unbun.dev/contracts/cc/lock-owner.schema.json",
  "title": "unbun cc cooperative lock owner",
  "type": "object",
  "required": ["schema", "schema_version", "token", "implementation", "pid", "hostname", "started_at", "command"],
  "properties": {
    "schema": { "const": "unbun.cc.lock-owner" },
    "schema_version": { "const": 1 },
    "token": { "type": "string", "format": "uuid", "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-4[0-9a-fA-F]{3}-[89aAbB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$" },
    "implementation": { "type": "string", "minLength": 1 },
    "pid": { "type": "integer", "minimum": 1 },
    "hostname": { "type": "string", "minLength": 1 },
    "started_at": { "type": "string", "format": "date-time", "pattern": "Z$" },
    "command": { "type": "string", "minLength": 1 }
  }
}