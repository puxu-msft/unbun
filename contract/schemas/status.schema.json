{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://unbun.dev/contracts/cc/status.schema.json",
  "title": "unbun cc status",
  "type": "object",
  "required": ["schema_version", "path", "version", "size_bytes", "has_baseline", "probe_error", "features"],
  "properties": {
    "schema_version": { "const": 1 },
    "path": { "type": "string", "minLength": 1 },
    "version": {
      "anyOf": [
        { "type": "string", "pattern": "^[0-9]+(?:\\.[0-9]+)*$" },
        { "type": "null" }
      ]
    },
    "size_bytes": { "type": "integer", "minimum": 0 },
    "has_baseline": { "type": "boolean" },
    "probe_error": { "type": ["object", "null"] },
    "features": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["slug", "state", "details", "sites", "substates"],
        "properties": {
          "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "state": { "enum": ["clean", "patched", "mixed", "unsupported"] },
          "details": { "type": "array" },
          "sites": { "type": "integer", "minimum": 0 },
          "substates": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["identity", "state"],
              "properties": {
                "identity": { "type": "string", "minLength": 1 },
                "state": { "enum": ["clean", "patched", "absent", "unsupported"] }
              }
            }
          }
        }
      }
    }
  }
}