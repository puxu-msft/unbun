{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://unbun.dev/contracts/cc/snapshot.schema.json",
  "title": "unbun cc snapshot manifest",
  "type": "object",
  "required": ["schema", "schema_version", "feature_contract", "path_key", "embedded_version", "slug", "blob", "sha256", "size", "observed_states", "created_at", "created_by"],
  "properties": {
    "schema": { "const": "unbun.cc.snapshot" },
    "schema_version": { "const": 1 },
    "feature_contract": { "const": "claude-v1" },
    "path_key": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "embedded_version": { "type": "string", "pattern": "^[0-9]+(?:\\.[0-9]+)*$" },
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "blob": { "type": "string", "pattern": "^blobs/[0-9a-f]{64}\\.ccsnap$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "size": { "type": "integer", "minimum": 0 },
    "observed_states": {
      "type": "object",
      "required": ["source-exec", "agent-model", "channels"],
      "properties": {
        "source-exec": { "enum": ["clean", "patched", "mixed", "unsupported"] },
        "agent-model": { "enum": ["clean", "patched", "mixed", "unsupported"] },
        "channels": { "enum": ["clean", "patched", "mixed", "unsupported"] }
      }
    },
    "created_at": { "type": "string", "format": "date-time", "pattern": "Z$" },
    "created_by": { "type": "string", "minLength": 1 }
  }
}