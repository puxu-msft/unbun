
# Editor and OS metadata.
.DS_Store
Thumbs.db

# js
node_modules/
dist/
coverage/

# py
__pycache__/
*.py[cod]
.venv/
.pytest_cache/

# Generated extraction, rebuild, and experiment outputs.
refs/
dumped/
python/cc-patch/backups/

# Broad safety net against accidentally committing large real binaries (e.g. extracted
# claude SFX in refs/, the ~94MB build-fixture `mini` which is ignored by name above).
*.bin
*.exe
*.macho

# ...but the small, frozen SYNTHETIC test fixtures are version-controlled contract inputs
# (pinned by manifests / contract/golden/SHA256SUMS; read directly by both test suites).
# They must be tracked despite the extension net; all are <3KB, generated by their own
# generator scripts (not rebuilt at test time), so a fresh clone needs them present.
!contract/golden/**/*.bin
!python/cc-patch/tests/golden/*.bin
!exp/exact-replay/fixtures/**/*.bin
!exp/exact-replay/fixtures/**/*.exe
!exp/exact-replay/fixtures/**/*.macho

